{% extends "base.html.j2" %}
{% block title %}Posts - Jonathon Waterhouse's blog{% endblock %}
{% block content %}
<div class="home-link">
    <a href="/">< Home</a>
</div>
<div class="home">
    <div class="post-list">
        <h1>Posts</h1>
        {% for slug in posts if not posts[slug]['is_draft'] %}
        {% set post = posts[slug] %}
        <div class="post-item">
            <a class="post-link" href="/post/{{ slug }}/">{{ post['title'] }}</a>
            <br />
            <span class="post-date">{{ post['created_at'].strftime('%B %-d, %Y') }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}